<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <appSettings>
    <add key="ConnStr" value="Server=localhost;Database=IISReports;Integrated Security=SSPI;Encrypt=True;TrustServerCertificate=False;Application Name=IISReportsV3.Agent;" />
    <add key="IISReportsScanSeconds" value="30" />
    <!-- Explicitly allow your test endpoint's hostname and port. No credentials are forwarded. -->
    <add key="IISReportsCheckHosts" value="" />
    <add key="IISReportsCheckPorts" value="80,443" />
    <add key="IISReportsAllowHttpChecks" value="false" />
    <!-- Generic HTTPS JSON webhook, not a Telegram/SMTP adapter. Keep any URL secret here only. -->
    <add key="IISReportsWebhookUrl" value="" />
    <add key="IISReportsWebhookHosts" value="" />
    <add key="IISReportsWebhookPorts" value="443" />
  </appSettings>
</configuration>
