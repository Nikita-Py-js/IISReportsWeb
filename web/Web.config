<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ConnStr" value="Server=localhost;Database=IISReports;Integrated Security=SSPI;Encrypt=True;TrustServerCertificate=False;Application Name=IISReports.Simple;" />
    <add key="LogRoots" value="C:\inetpub\logs\LogFiles" />
    <add key="ImportBatchesPerRequest" value="12" />
    <add key="ImportSecondsPerRequest" value="12" />
    <add key="EvaluateRules" value="true" />
    <!-- Optional HTTP probes / webhook. Empty allowlists mean no outgoing requests. -->
    <add key="IISReportsCheckHosts" value="" />
    <add key="IISReportsCheckPorts" value="80,443" />
    <add key="IISReportsAllowHttpChecks" value="false" />
    <add key="IISReportsWebhookUrl" value="" />
    <add key="IISReportsWebhookHosts" value="" />
    <add key="IISReportsWebhookPorts" value="443" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8">
      <assemblies><add assembly="System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" /><add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" /></assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" executionTimeout="180" maxRequestLength="128" enableVersionHeader="false" />
    <authentication mode="None" />
    <identity impersonate="false" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <httpErrors existingResponse="PassThrough" />
    <defaultDocument enabled="true"><files><clear /><add value="index.html" /></files></defaultDocument>
  </system.webServer>
</configuration>
